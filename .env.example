# Copy to .env.local for development, or set these as encrypted secrets
# in your hosting platform (Vercel/AWS/etc.) for production. Never commit
# a real .env file — .env* is in .gitignore.

# --- Database -----------------------------------------------------------
DATABASE_URL="postgresql://user:password@host:5432/events_portal?sslmode=require"

# --- Session / CSRF secrets ---------------------------------------------
# Generate with: openssl rand -base64 32
AUDIT_IP_PEPPER=""
CSRF_PUBLIC_SECRET=""

# --- Rate limiting (Redis / Upstash) ------------------------------------
REDIS_URL=""

# --- Object storage (S3, private bucket) --------------------------------
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_MEDIA_BUCKET="shivnadar-events-media"

# --- First-run admin seed (optional override) ---------------------------
SEED_ADMIN_EMAIL="admin@snseventsportal.example"

# --- App -----------------------------------------------------------------
NODE_ENV="production"
NEXT_PUBLIC_SITE_URL="https://events.snseventsportal.example"
