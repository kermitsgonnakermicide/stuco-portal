# Render production environment reference.
# These are provided by Render's managed add-ons and the blueprint
# (render.yaml) automatically — you do NOT need to set most of these.
# Only the `sync: false` secrets must be entered manually in the
# Render dashboard (or via env var groups). NEVER commit real values.

# --- Provided automatically by Render (see render.yaml, do not override) --
# DATABASE_URL   (from the Postgres add-on)
# REDIS_URL      (from the Redis add-on)
# PORT            (service port)

# --- Secrets: set manually (__REQUIRED__ in production) -------------------
# Generate each with:  openssl rand -base64 32
AUDIT_IP_PEPPER=""
CSRF_PUBLIC_SECRET=""

# --- App -------------------------------------------------------------------
NODE_ENV=production
NEXT_PUBLIC_SITE_URL="https://<your-service>.onrender.com"
SEED_ADMIN_EMAIL="admin@yourschool.example"
# Optional: converge the admin password to this on every deploy (12-200 chars).
# Prefer a hosting-platform secret store so it is never readable via CLIs.
SEED_ADMIN_PASSWORD=""

# --- Object storage (S3, private bucket) -----------------------------------
# Only needed if the school uses media uploads. Set these to real AWS keys
# scoped to a private bucket that allows only this service.
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_MEDIA_BUCKET=""