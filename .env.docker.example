# Copy to `.env` (same directory as docker-compose.yml) to override the
# DEMO defaults in docker-compose.yml. Compose reads this file automatically.
# NEVER commit a real .env.

# --- Database -----------------------------------------------------------
POSTGRES_USER=events
POSTGRES_PASSWORD=use-a-long-random-string

# --- Session / CSRF secrets ---------------------------------------------
# Generate with: openssl rand -base64 32
AUDIT_IP_PEPPER=
CSRF_PUBLIC_SECRET=

# --- First-run admin seed -----------------------------------------------
SEED_ADMIN_EMAIL=admin@snseventsportal.example

# --- Object storage (optional; uploads fail without real S3 creds) ------
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_MEDIA_BUCKET=shivnadar-events-media
